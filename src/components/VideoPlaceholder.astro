---
/**
 * VideoPlaceholder
 * Renders a branded video placeholder wherever a real video isn't available yet.
 * Swap it out by simply adding a videoUrl to the project's frontmatter.
 */

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<div class="relative w-full aspect-video overflow-hidden rounded-sm border border-dashed border-af-blue/25 bg-af-surface flex flex-col items-center justify-center gap-4">
  <!-- Dot pattern -->
  <div class="absolute inset-0 bg-dots opacity-30"></div>

  <!-- Corner marks -->
  <span class="absolute top-3 left-3 w-3 h-3 border-t border-l border-af-blue/30"></span>
  <span class="absolute top-3 right-3 w-3 h-3 border-t border-r border-af-blue/30"></span>
  <span class="absolute bottom-3 left-3 w-3 h-3 border-b border-l border-af-blue/30"></span>
  <span class="absolute bottom-3 right-3 w-3 h-3 border-b border-r border-af-blue/30"></span>

  <!-- Play button ring -->
  <div class="relative z-10 flex flex-col items-center gap-3">
    <div class="w-16 h-16 rounded-full border border-af-blue/30 bg-af-blue/10 flex items-center justify-center">
      <svg aria-hidden="true" focusable="false" class="w-7 h-7 text-af-blue opacity-50 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </div>

    <div class="text-center">
      <p class="font-mono text-xs text-af-blue/50 tracking-widest uppercase">Video coming soon</p>
      {title && (
        <p class="text-af-gray text-xs mt-1">{title}</p>
      )}
    </div>
  </div>
</div>
