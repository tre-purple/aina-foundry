---
/**
 * ImagePlaceholder
 * Renders a branded placeholder wherever a real photo isn't available yet.
 * Swap it out by simply adding an image path to the project's frontmatter.
 */

interface Props {
  category?: string;
  label?: string;
  /** Tailwind aspect-ratio class e.g. 'aspect-video' or 'aspect-[21/9]' */
  aspect?: string;
  /** Show a dimmer, smaller version for gallery grid slots */
  compact?: boolean;
}

const {
  category = 'other',
  label = 'Photo coming soon',
  aspect = 'aspect-video',
  compact = false,
} = Astro.props;

// Per-category accent color + icon path
const categoryConfig: Record<string, { color: string; icon: string }> = {
  restoration: {
    color: 'text-af-green border-af-green/20 bg-af-green/5',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5"/>`,
  },
  sensors: {
    color: 'text-af-blue border-af-blue/20 bg-af-blue/5',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6"/>`,
  },
  communications: {
    color: 'text-af-teal border-af-teal/20 bg-af-teal/5',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"/>`,
  },
  data: {
    color: 'text-purple-400 border-purple-500/20 bg-purple-500/5',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 2.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125m0 5.625c0 2.278 3.694 4.125 8.25 4.125s8.25-1.847 8.25-4.125"/>`,
  },
  education: {
    color: 'text-yellow-400 border-yellow-500/20 bg-yellow-500/5',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.63 48.63 0 0112 20.904a48.63 48.63 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>`,
  },
  health: {
    color: 'text-rose-400 border-rose-500/20 bg-rose-500/5',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>`,
  },
  infrastructure: {
    color: 'text-orange-400 border-orange-500/20 bg-orange-500/5',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/>`,
  },
  other: {
    color: 'text-af-gray border-af-muted/30 bg-af-muted/10',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>`,
  },
};

const cfg = categoryConfig[category] ?? categoryConfig.other;
const iconSize = compact ? 'w-7 h-7' : 'w-10 h-10';
---

<div class:list={[
  'relative w-full overflow-hidden border border-dashed bg-af-surface flex flex-col items-center justify-center gap-3',
  aspect,
  cfg.color,
]}>
  <!-- Dot pattern background -->
  <div class="absolute inset-0 bg-dots opacity-40"></div>

  <!-- Corner marks -->
  <span class="absolute top-3 left-3 w-3 h-3 border-t border-l opacity-30 border-current"></span>
  <span class="absolute top-3 right-3 w-3 h-3 border-t border-r opacity-30 border-current"></span>
  <span class="absolute bottom-3 left-3 w-3 h-3 border-b border-l opacity-30 border-current"></span>
  <span class="absolute bottom-3 right-3 w-3 h-3 border-b border-r opacity-30 border-current"></span>

  <!-- Icon -->
  <svg class:list={[iconSize, 'opacity-40 relative z-10']} fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={cfg.icon} />

  <!-- Label -->
  {!compact && (
    <span class="relative z-10 font-mono text-xs opacity-50 tracking-widest uppercase">{label}</span>
  )}
</div>
