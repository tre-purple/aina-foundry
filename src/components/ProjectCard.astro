---
import type { CollectionEntry } from 'astro:content';
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { title, tagline, status, category, tags, year, coverImage } = project.data;

const statusConfig: Record<string, { label: string; color: string }> = {
  active:     { label: 'Active',     color: 'bg-af-green/20 text-af-green border-af-green/30' },
  prototype:  { label: 'Prototype',  color: 'bg-af-blue/20 text-af-blue border-af-blue/30' },
  venture:    { label: 'Venture',    color: 'bg-af-teal/20 text-af-teal border-af-teal/30' },
  research:   { label: 'Research',   color: 'bg-purple-500/20 text-purple-300 border-purple-500/30' },
  completed:  { label: 'Completed',  color: 'bg-af-muted/30 text-af-silver border-af-muted/40' },
};

const s = statusConfig[status] ?? statusConfig.prototype;
---

<a
  href={`/aina-foundry/projects/${project.slug}`}
  class:list={[
    'group card flex flex-col overflow-hidden',
    featured ? 'h-full' : '',
  ]}
>
  <!-- Cover image or placeholder -->
  <div class="relative aspect-video overflow-hidden bg-af-surface">
    {coverImage ? (
      <img
        src={coverImage}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <ImagePlaceholder category={category} compact={true} aspect="aspect-video" />
    )}

    <!-- Status badge -->
    <div class="absolute top-3 right-3">
      <span class:list={['inline-flex items-center text-[11px] font-mono font-medium px-2 py-0.5 rounded-sm border', s.color]}>
        {s.label}
      </span>
    </div>

    <!-- Hover overlay -->
    <div class="absolute inset-0 bg-af-green/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  </div>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5">
    <div class="flex items-start justify-between gap-2 mb-2">
      <h3 class="text-af-white font-semibold text-base leading-snug group-hover:text-af-green transition-colors duration-200">
        {title}
      </h3>
      <span class="font-mono text-xs text-af-muted flex-shrink-0 mt-0.5">{year}</span>
    </div>

    <p class="text-af-gray text-sm leading-relaxed flex-1 mb-4">{tagline}</p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map(tag => (
        <span class="tag">{tag}</span>
      ))}
      {tags.length > 3 && (
        <span class="tag text-af-muted">+{tags.length - 3}</span>
      )}
    </div>

    <!-- Arrow -->
    <div class="mt-4 flex items-center gap-1.5 text-xs font-mono text-af-muted group-hover:text-af-green transition-colors duration-200">
      View project
      <svg class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </div>
  </div>
</a>
