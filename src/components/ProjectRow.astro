---
import type { CollectionEntry } from 'astro:content';
import { stackLayers } from '../data/sovereignty';
import { statusLabels, withBase } from '../data/site';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, tagline, status, stack } = project.data;
const layer = stackLayers.find(l => l.key === stack);
---

<a
  href={withBase(`projects/${project.id}/`)}
  class="group grid-site gap-y-1 items-baseline py-5 sm:py-6 border-t border-rule-light"
>
  <span class="caps text-graphite col-span-2 sm:col-span-1">{String(index + 1).padStart(2, '0')}</span>
  <span class="col-span-10 sm:col-span-7">
    <span class="block text-2xl sm:text-3xl font-medium tracking-[-0.02em] leading-tight sm:leading-[1.2] transition-transform duration-500 ease-out group-hover:translate-x-2">
      {title}
    </span>
    <span class="block mt-2 text-[15px] leading-snug text-graphite max-w-[60ch]">{tagline}</span>
  </span>
  <span class="caps text-graphite col-start-3 col-span-5 sm:col-start-auto sm:col-span-2">{layer?.name}</span>
  <span class="caps col-span-5 sm:col-span-2 flex justify-between gap-2">
    {statusLabels[status]}
    <span aria-hidden="true" class="opacity-0 -translate-x-2 transition-all duration-500 group-hover:opacity-100 group-hover:translate-x-0">→</span>
  </span>
</a>
