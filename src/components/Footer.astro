---
import { contactEmail, navLinks } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="on-paper bg-paper text-ink overflow-hidden">
  <div class="wrap pt-8 pb-8">
    <div class="grid-site gap-y-6">
      <p class="caps col-span-12 sm:col-span-3">ʻĀina Foundry</p>
      <p class="caps col-span-12 sm:col-span-5 text-graphite">
        A department of Purple Maiʻa Foundation.<br />
        Hawaiʻi. © {year}.
      </p>
      <nav aria-label="Footer" class="col-span-12 sm:col-span-4">
        <ul>
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="caps link-line inline-block py-[5px]"
              >
                {link.label}{link.external && <span aria-hidden="true"> ↗</span>}
              </a>
            </li>
          ))}
          <li>
            <a href="https://purplemaia.org" target="_blank" rel="noopener noreferrer" class="caps link-line inline-block py-[5px]">
              Purple Maiʻa<span aria-hidden="true"> ↗</span>
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <p
      aria-hidden="true"
      class="font-medium tracking-[-0.05em] leading-[0.8] mt-24 sm:mt-40 -ml-[0.04em] whitespace-nowrap text-[calc((100vw-2rem)/5.85)] sm:text-[min(calc((100vw-4rem)/5.85),276px)]"
    >
      ʻĀina Foundry
    </p>

    <div class="grid-site gap-y-6 mt-10 sm:mt-14">
      <p class="caps col-span-12 sm:col-span-8 text-graphite">Building the Sovereign Stack</p>
      <div class="col-span-12 sm:col-span-4">
        <p class="caps text-graphite mb-2">Contact</p>
        <a href={`mailto:${contactEmail}`} class="caps link-line">{contactEmail}</a>
      </div>
    </div>
  </div>
</footer>
