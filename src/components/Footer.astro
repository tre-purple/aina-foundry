---
const year = new Date().getFullYear();
---

<footer class="border-t border-af-border mt-24">
  <div class="container-site py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 flex-shrink-0">
            <polygon points="16,3 29,27 3,27" fill="none" stroke="#4ADE80" stroke-width="1.5"/>
            <line x1="9" y1="20" x2="23" y2="20" stroke="#4ADE80" stroke-width="1.5"/>
            <circle cx="16" cy="3" r="1.5" fill="#4ADE80"/>
            <circle cx="3" cy="27" r="1.5" fill="#22C55E" opacity="0.6"/>
            <circle cx="29" cy="27" r="1.5" fill="#22C55E" opacity="0.6"/>
          </svg>
          <span class="text-af-white font-bold text-sm">ʻĀina Foundry</span>
        </div>
        <p class="text-af-gray text-sm leading-relaxed max-w-xs">
          Applied innovation and prototyping at Purple Maiʻa Foundation. Turning community-vetted ideas into tangible tools.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-af-white font-semibold text-sm mb-4">Navigate</h4>
        <ul class="space-y-2">
          {[
            { label: 'Projects', href: '/aina-foundry/projects' },
            { label: 'About', href: '/aina-foundry/about' },
            { label: 'Blog', href: 'https://blog.labs.purplemaia.org/', external: true },
          ].map(link => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="text-af-gray text-sm hover:text-af-green transition-colors duration-200"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Mission -->
      <div>
        <h4 class="text-af-white font-semibold text-sm mb-4">Our Purpose</h4>
        <p class="text-af-gray text-sm leading-relaxed">
          Indigenous Innovation does not stop at inspiration — it moves into practice, learning, and real-world impact.
        </p>
        <div class="mt-4">
          <a
            href="https://purplemaia.org"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-mono text-af-green hover:text-af-green/80 transition-colors"
          >
            Purple Maiʻa Foundation
            <svg aria-hidden="true" focusable="false" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t border-af-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-mono text-xs text-af-gray">
        © {year} ʻĀina Foundry · Purple Maiʻa Foundation · All rights reserved.
      </p>
      <p class="font-mono text-xs text-af-gray">
        Technology must honor place, respect ʻike, and return value to community.
      </p>
    </div>
  </div>
</footer>
