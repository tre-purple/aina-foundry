---
import { contactEmail, navLinks, withBase } from '../data/site';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath.startsWith(href);
---

<!-- Top bar sits over each page's ink hero and scrolls away with it -->
<header class="absolute top-0 inset-x-0 z-40 text-paper">
  <div class="wrap grid-site pt-7">
    <a href={withBase()} class="caps col-span-6 sm:col-span-3 self-start link-line justify-self-start">ʻĀina Foundry</a>
    <p class="caps hidden md:block md:col-span-5 text-smoke">Purple Maiʻa Foundation</p>
    <nav aria-label="Main" class="hidden lg:block lg:col-span-3">
      <ul>
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              aria-current={!link.external && isCurrent(link.href) ? 'page' : undefined}
              class="caps link-line inline-block py-[5px]"
            >
              {link.label}{link.external && <span aria-hidden="true"> ↗</span>}
            </a>
          </li>
        ))}
        <li><a href={`mailto:${contactEmail}`} class="caps link-line inline-block py-[5px]">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<!-- Persistent controls: menu always; contact appears once the top bar has scrolled away -->
<div class="fixed top-6 right-4 sm:right-8 z-50 flex items-center gap-1">
  <a
    id="float-contact"
    href={`mailto:${contactEmail}`}
    class="caps bg-[#1C1C1C] text-paper px-2.5 py-1.5 hover:bg-[#333] transition-all duration-300 opacity-0 pointer-events-none -translate-y-1"
    tabindex="-1"
  >
    Contact
  </a>
  <button
    id="menu-open"
    class="bg-[#1C1C1C] text-paper w-[26px] h-[26px] flex flex-col items-center justify-center gap-[3px] hover:bg-[#333] transition-colors"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="site-menu"
  >
    <span class="block w-3 h-px bg-current"></span>
    <span class="block w-3 h-px bg-current"></span>
  </button>
</div>

<!-- Full-screen menu -->
<div
  id="site-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  class="fixed inset-0 z-[60] bg-ink text-paper hidden"
>
  <div class="wrap h-full flex flex-col pt-7 pb-8">
    <div class="grid-site items-start">
      <a href={withBase()} class="caps col-span-6 sm:col-span-3 link-line justify-self-start">ʻĀina Foundry</a>
      <button id="menu-close" class="caps col-start-10 col-span-3 justify-self-end link-line">Close</button>
    </div>

    <nav aria-label="Menu" class="mt-auto">
      <ul>
        {[{ label: 'Home', href: withBase() }, ...navLinks].map((link, i) => (
          <li class="border-t border-rule-dark">
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="group grid-site items-baseline py-3"
            >
              <span class="caps text-smoke col-span-2 sm:col-span-3">0{i + 1}</span>
              <span class="headline col-span-10 sm:col-span-9 text-smoke group-hover:text-paper transition-colors duration-300">
                {link.label}{link.external && <span aria-hidden="true" class="text-[0.5em] align-top"> ↗</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="grid-site mt-10 pt-5 border-t border-rule-dark">
      <p class="caps text-smoke col-span-12 sm:col-span-3 mb-3">Contact</p>
      <a href={`mailto:${contactEmail}`} class="caps col-span-12 sm:col-span-9 link-line justify-self-start">{contactEmail}</a>
    </div>
  </div>
</div>

<script>
  const menu = document.getElementById('site-menu');
  const openBtn = document.getElementById('menu-open');
  const closeBtn = document.getElementById('menu-close');
  const floatContact = document.getElementById('float-contact');

  function setMenu(open: boolean) {
    menu?.classList.toggle('hidden', !open);
    // Make the page behind the menu unreachable by keyboard and screen readers while it's open.
    [...document.body.children].forEach(el => {
      if (el !== menu && el instanceof HTMLElement && el.tagName !== 'SCRIPT') el.inert = open;
    });
    document.body.style.overflow = open ? 'hidden' : '';
    openBtn?.setAttribute('aria-expanded', String(open));
    if (open) closeBtn?.focus();
    else openBtn?.focus();
  }

  openBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) setMenu(false);
  });

  // Reveal the floating contact link once the top bar is out of view.
  const onScroll = () => {
    const shown = window.scrollY > window.innerHeight * 0.6;
    floatContact?.classList.toggle('opacity-0', !shown);
    floatContact?.classList.toggle('pointer-events-none', !shown);
    floatContact?.classList.toggle('-translate-y-1', !shown);
    floatContact?.setAttribute('tabindex', shown ? '0' : '-1');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
