---
import BaseLayout from './BaseLayout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import VideoPlaceholder from '../components/VideoPlaceholder.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, tagline, description, status, category, tags, year, coverImage, images, videoUrl, team, partners, links, featured } = project.data;

const statusConfig: Record<string, { label: string; color: string }> = {
  active:          { label: 'Active',        color: 'tag-green' },
  prototype:       { label: 'Prototype',     color: 'tag-blue' },
  testing:         { label: 'Testing / QA',  color: 'tag text-amber-300 bg-amber-500/10 border-amber-500/20' },
  'initial-build': { label: 'Initial Build', color: 'tag text-indigo-300 bg-indigo-500/10 border-indigo-500/20' },
  venture:         { label: 'Venture',       color: 'tag-teal' },
  research:        { label: 'Research',      color: 'tag text-purple-300 bg-purple-500/10 border-purple-500/20' },
  completed:       { label: 'Completed',     color: 'tag' },
};

const s = statusConfig[status] ?? statusConfig.prototype;
const primaryLink = links?.find(l => l.highlight);

const categoryLabels: Record<string, string> = {
  restoration:                'ʻĀina Restoration',
  sensors:                    'Sensors & Monitoring',
  communications:             'Communications',
  data:                       'Data & AI',
  education:                  'Education',
  health:                     'Health',
  infrastructure:             'Infrastructure',
  'place-based':              'Place-Based Engineering',
  'agentic-governance':       'Agentic Governance',
  'sustainable-ai':           'Sustainable AI Infrastructure',
  'environmental-intelligence': 'Environmental Intelligence',
  other:                      'Other',
};
---

<BaseLayout title={title} description={description} ogImage={coverImage}>
  <!-- Back nav -->
  <div class="container-site pt-8 pb-4">
    <a href="/aina-foundry/projects" class="inline-flex items-center gap-2 text-sm text-af-gray hover:text-af-white transition-colors font-mono">
      <svg aria-hidden="true" focusable="false" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      All Projects
    </a>
  </div>

  <!-- Hero image or placeholder -->
  {coverImage ? (
    <div class="w-full aspect-[21/9] overflow-hidden bg-af-surface">
      <img src={coverImage} alt={title} class="w-full h-full object-cover" />
    </div>
  ) : (
    <div class="container-site pt-2">
      <ImagePlaceholder category={category} aspect="aspect-[21/9]" label="Cover photo coming soon" />
    </div>
  )}

  <div class="container-site py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Main content -->
      <div class="lg:col-span-2">
        <!-- Header -->
        <div class="mb-8">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class:list={[s.color]}>{s.label}</span>
            <span class="tag">{categoryLabels[category] ?? category}</span>
            <span class="font-mono text-xs text-af-gray">{year}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-af-white mb-3 leading-tight">{title}</h1>
          <p class="text-lg text-af-silver leading-relaxed">{tagline}</p>
          {primaryLink && (
            <div class="mt-5">
              <a
                href={primaryLink.url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary"
              >
                {primaryLink.label}
                <svg aria-hidden="true" focusable="false" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </div>
          )}
        </div>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mb-10">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>

        <!-- Video embed or placeholder -->
        {videoUrl ? (
          <div class="mb-10 rounded-sm overflow-hidden aspect-video bg-af-surface border border-af-border">
            <iframe
              src={videoUrl}
              title={`${title} video`}
              class="w-full h-full"
              allowfullscreen
              loading="lazy"
            />
          </div>
        ) : (
          <div class="mb-10">
            <VideoPlaceholder title={title} />
          </div>
        )}

        <!-- MDX content -->
        <article class="prose-af">
          <slot />
        </article>

        <!-- Image gallery or placeholder grid -->
        <div class="mt-12">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-af-white font-bold text-xl">Gallery</h2>
            {(!images || images.length === 0) && (
              <span class="font-mono text-xs text-af-gray tracking-widest uppercase">Photos coming soon</span>
            )}
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {(images && images.length > 0) ? (
              images.map((img, i) => (
                <div class="rounded-sm overflow-hidden border border-af-border bg-af-surface aspect-video">
                  <img
                    src={img}
                    alt={`${title} — image ${i + 1}`}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-500 cursor-zoom-in"
                    loading="lazy"
                  />
                </div>
              ))
            ) : (
              // Show 4 placeholder slots when no gallery images exist yet
              [1, 2, 3, 4].map(n => (
                <ImagePlaceholder
                  category={category}
                  aspect="aspect-video"
                  compact={true}
                />
              ))
            )}
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-1">
        <div class="sticky top-24 space-y-6">

          <!-- Project details -->
          <div class="card p-6">
            <h3 class="text-af-white font-semibold text-sm mb-4">Project Details</h3>
            <dl class="space-y-3">
              <div>
                <dt class="font-mono text-[11px] text-af-gray uppercase tracking-widest mb-1">Status</dt>
                <dd><span class:list={[s.color, 'text-xs']}>{s.label}</span></dd>
              </div>
              <div>
                <dt class="font-mono text-[11px] text-af-gray uppercase tracking-widest mb-1">Category</dt>
                <dd class="text-af-silver text-sm">{categoryLabels[category] ?? category}</dd>
              </div>
              <div>
                <dt class="font-mono text-[11px] text-af-gray uppercase tracking-widest mb-1">Year</dt>
                <dd class="text-af-silver text-sm font-mono">{year}</dd>
              </div>
            </dl>
          </div>

          <!-- Team -->
          {team && team.length > 0 && (
            <div class="card p-6">
              <h3 class="text-af-white font-semibold text-sm mb-4">Team</h3>
              <ul class="space-y-2">
                {team.map(member => (
                  <li class="flex items-center gap-2 text-sm text-af-silver">
                    <div class="w-1.5 h-1.5 rounded-full bg-af-green flex-shrink-0"></div>
                    {member}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Partners -->
          {partners && partners.length > 0 && (
            <div class="card p-6">
              <h3 class="text-af-white font-semibold text-sm mb-4">Partners</h3>
              <ul class="space-y-2">
                {partners.map(partner => (
                  <li class="flex items-center gap-2 text-sm text-af-silver">
                    <div class="w-1.5 h-1.5 rounded-full bg-af-blue flex-shrink-0"></div>
                    {partner}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Links -->
          {links && links.length > 0 && (
            <div class="card p-6">
              <h3 class="text-af-white font-semibold text-sm mb-4">Links</h3>
              <div class="space-y-2">
                {links.map(link => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      'flex items-center gap-2 text-sm transition-colors',
                      link.highlight
                        ? 'text-af-green hover:text-af-green/80'
                        : 'text-af-gray hover:text-af-silver',
                    ]}
                  >
                    <svg aria-hidden="true" focusable="false" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Back to projects -->
          <a href="/aina-foundry/projects" class="btn-outline w-full justify-center">
            ← Back to Projects
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
