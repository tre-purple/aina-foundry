---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { stackLayers } from '../data/sovereignty';
import { statusLabels, withBase } from '../data/site';

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { title, tagline, description, status, stack, year, coverImage, images, videoUrl, team, partners, links } = project.data;

const layer = stackLayers.find(l => l.key === stack);
const primaryLink = links?.find(l => l.highlight);

const meta = [
  { label: 'Layer', value: layer?.name },
  { label: 'Status', value: statusLabels[status] },
  { label: 'Year', value: String(year) },
].filter(m => m.value);
---

<BaseLayout title={title} description={description} ogImage={coverImage}>
  <!-- Hero -->
  <section class="bg-ink text-paper">
    <div class="wrap pt-40 sm:pt-48 pb-8">
      <a href={withBase("projects/")} class="caps link-line">← All projects</a>
      <h1 class="headline mt-16 sm:mt-24 max-w-[16ch]">{title}</h1>

      <div class="grid-site gap-y-8 mt-20 sm:mt-28">
        <dl class="col-span-12 lg:col-span-8 grid grid-cols-3 gap-x-4 sm:gap-x-8 max-w-xl">
          {meta.map(m => (
            <div>
              <dt class="caps text-smoke mb-1">{m.label}</dt>
              <dd class="caps">{m.value}</dd>
            </div>
          ))}
        </dl>
        <p class="caps col-span-12 lg:col-span-4">{tagline}</p>
      </div>
    </div>
  </section>

  {coverImage && (
    <img src={coverImage} alt="" class="w-full aspect-[21/9] object-cover bg-ink" />
  )}

  <!-- Body -->
  <section class="on-paper bg-paper text-ink">
    <div class="wrap pt-8 pb-24 sm:pb-32">
      <div class="grid-site gap-y-12">
        <aside class="col-span-12 lg:col-span-3 order-2 lg:order-1">
          <div class="lg:sticky lg:top-8 space-y-10">
            {team && team.length > 0 && (
              <div>
                <h2 class="caps text-graphite mb-2">Team</h2>
                <ul>{team.map(member => <li class="caps">{member}</li>)}</ul>
              </div>
            )}
            {partners && partners.length > 0 && (
              <div>
                <h2 class="caps text-graphite mb-2">Partners</h2>
                <ul>{partners.map(partner => <li class="caps">{partner}</li>)}</ul>
              </div>
            )}
            {links && links.length > 0 && (
              <div>
                <h2 class="caps text-graphite mb-2">Links</h2>
                <ul>
                  {links.map(link => (
                    <li>
                      <a href={link.url} target="_blank" rel="noopener noreferrer" class="caps link-line">
                        {link.label} <span aria-hidden="true">↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </aside>

        <div class="col-span-12 lg:col-start-5 lg:col-span-8 order-1 lg:order-2">
          <p class="statement mb-10">{description}</p>
          {primaryLink && (
            <a href={primaryLink.url} target="_blank" rel="noopener noreferrer" class="caps inline-block bg-ink text-paper px-3 py-2 hover:bg-[#333] transition-colors mb-4">
              {primaryLink.label} ↗
            </a>
          )}

          {videoUrl && (
            <div class="aspect-video bg-ink mt-12">
              <iframe src={videoUrl} title={`${title} video`} class="w-full h-full" allowfullscreen loading="lazy" />
            </div>
          )}

          <article class="prose-site">
            <slot />
          </article>

          {images && images.length > 0 && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-8 mt-16">
              {images.map((img, i) => (
                <img src={img} alt={`${title} — image ${i + 1}`} class="w-full aspect-[4/3] object-cover" loading="lazy" />
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Next project -->
  <a href={withBase(`projects/${next.id}/`)} class="group block bg-ink text-paper">
    <div class="wrap pt-8 pb-24 sm:pb-32">
      <div class="grid-site">
        <p class="caps col-span-6 sm:col-span-8">Next project</p>
        <p class="caps col-span-6 sm:col-span-4 text-smoke">{stackLayers.find(l => l.key === next.data.stack)?.name}</p>
      </div>
      <p class="headline mt-20 sm:mt-28 text-smoke group-hover:text-paper transition-colors duration-500">
        {next.data.title} <span aria-hidden="true" class="inline-block transition-transform duration-500 group-hover:translate-x-3">→</span>
      </p>
    </div>
  </a>
</BaseLayout>
