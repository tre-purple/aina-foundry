---
import BaseLayout from '../layouts/BaseLayout.astro';

const values = [
  {
    title: 'Honor Place',
    description: 'Technology is never neutral. We design with deep awareness of the ʻāina, waters, and communities our work touches.',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>`,
  },
  {
    title: 'Respect ʻIke',
    description: 'Indigenous knowledge systems are valid, rigorous, and irreplaceable. Our tech amplifies, never supplants.',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/></svg>`,
  },
  {
    title: 'Return Value',
    description: 'Community invests time and knowledge — we ensure the value generated returns to the communities that made it possible.',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3"/></svg>`,
  },
  {
    title: 'Move to Practice',
    description: 'Inspiration is the beginning, not the end. Every idea here is tracked from concept through prototype into real-world application.',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>`,
  },
];

const focus = [
  { label: 'ʻĀina Restoration', desc: 'Tools for ahupuaʻa stewardship, invasive species monitoring, and ecological restoration.' },
  { label: 'Environmental Sensors', desc: 'Low-cost, community-deployable sensors for water quality, air, and land health monitoring.' },
  { label: 'Communications', desc: 'Resilient, mesh, and offline-capable communication tools for remote and underserved communities.' },
  { label: 'Data & AI', desc: 'Ethical AI tools that center indigenous data sovereignty and community-defined metrics of success.' },
  { label: 'Education', desc: 'Platforms and tools that bring STEM into cultural context for Hawaiian and Pacific learners.' },
  { label: 'Health', desc: 'Community health technology that bridges traditional healing practices with modern delivery.' },
];
---

<BaseLayout
  title="About"
  description="About ʻĀina Foundry — the applied innovation and prototyping arm of Purple Maiʻa Foundation."
>
  <!-- Hero -->
  <section class="relative py-24 border-b border-af-border overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-40"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-af-green/4 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-site relative z-10 max-w-4xl">
      <p class="section-label mb-4">About</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-af-white mb-6 leading-tight">
        We build the tools<br />community needs<br />
        <span class="text-af-green">to thrive.</span>
      </h1>
      <p class="text-lg text-af-silver leading-relaxed max-w-2xl">
        ʻĀina Foundry is the applied innovation and prototyping department of Purple Maiʻa Foundation.
        We pair rapid prototyping with cultural grounding to build technology that is locally rooted,
        environmentally mindful, and built to last.
      </p>
    </div>
  </section>

  <!-- What We Do -->
  <section class="container-site py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <p class="section-label mb-4">What We Do</p>
        <h2 class="section-heading mb-6">From inspiration to impact.</h2>
        <div class="space-y-4 prose-af">
          <p>
            ʻĀina Foundry exists to ensure Indigenous Innovation does not stop at inspiration—but
            moves into practice, learning, and real-world impact.
          </p>
          <p>
            We work across the full arc of an idea: community vetting and co-design, rapid
            prototyping, iteration, and—when a solution is ready—transition into a venture or
            open-source tool that continues to serve the community that built it.
          </p>
          <p>
            Our projects span ʻāina restoration, environmental sensing, communications infrastructure,
            education, health, and data sovereignty. The common thread is a belief that technology
            must honor place, respect ʻike, and return value to community.
          </p>
        </div>
      </div>

      <!-- Focus areas -->
      <div class="space-y-4">
        <p class="section-label mb-2">Focus Areas</p>
        {focus.map(item => (
          <div class="card p-5 flex gap-4">
            <div class="w-1.5 flex-shrink-0 bg-af-green/40 rounded-full mt-1"></div>
            <div>
              <h3 class="text-af-white font-semibold text-sm mb-1">{item.label}</h3>
              <p class="text-af-gray text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="border-t border-af-border py-24">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="section-label mb-4">Values</p>
        <h2 class="section-heading">How we work.</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map((v, i) => (
          <div class="card p-6">
            <div class="w-9 h-9 rounded-sm bg-af-green/10 text-af-green flex items-center justify-center mb-4" set:html={v.icon} />
            <div class="font-mono text-xs text-af-muted mb-2">0{i + 1}</div>
            <h3 class="text-af-white font-semibold mb-2">{v.title}</h3>
            <p class="text-af-gray text-sm leading-relaxed">{v.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Purple Maiʻa -->
  <section class="container-site py-24">
    <div class="relative card p-8 sm:p-12 overflow-hidden">
      <div class="absolute inset-0 bg-dots opacity-30"></div>
      <div class="relative z-10 max-w-2xl">
        <p class="section-label mb-4">Parent Organization</p>
        <h2 class="text-2xl font-bold text-af-white mb-4">Purple Maiʻa Foundation</h2>
        <p class="text-af-silver leading-relaxed mb-6">
          ʻĀina Foundry is a department of Purple Maiʻa Foundation — a Hawaiʻi-based nonprofit
          dedicated to connecting Native Hawaiian and Pacific Islander communities to STEM education
          and economic opportunity through culturally relevant programming.
        </p>
        <a
          href="https://purplemaia.org"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline"
        >
          Visit Purple Maiʻa Foundation
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="container-site pb-24">
    <div class="text-center">
      <p class="section-label mb-4">Connect</p>
      <h2 class="section-heading mb-4">Work with us.</h2>
      <p class="prose-af mb-8 max-w-xl mx-auto">
        Whether you have a community challenge, a half-formed idea, or a prototype that needs
        to move to the next stage — we want to hear from you.
      </p>
      <a href="mailto:foundry@purplemaia.org" class="btn-primary text-base px-8 py-3">
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>
