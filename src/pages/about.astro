---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import hackathonPhoto from '../assets/build4aina-2025.jpg';
import { stackLayers, values } from '../data/sovereignty';
import { contactEmail } from '../data/site';

const [dataLayer, computeLayer] = stackLayers;

const process = [
  { title: 'Community vetting & co-design', description: 'Every project starts with a need named by community, and is shaped with the people it serves.' },
  { title: 'Rapid prototyping', description: 'We move from idea to working prototype fast, at the speed of community need.' },
  { title: 'Iteration in place', description: 'Prototypes are tested on the ground — on farms, in classrooms, in organizations — and refined.' },
  { title: 'Venture or open tool', description: 'When a solution is ready, it transitions into a venture or open-source tool that keeps serving the community that built it.' },
];
---

<BaseLayout
  title="About"
  description="About ʻĀina Foundry — building decentralized, community-governed data and compute infrastructure at Purple Maiʻa Foundation."
>
  <!-- Hero -->
  <section class="bg-ink text-paper">
    <div class="wrap pt-48 sm:pt-64 pb-8">
      <h1 class="display">
        Knowledge back<br />in community hands.
      </h1>
      <div class="grid-site gap-y-4 mt-24 sm:mt-32">
        <p class="caps col-span-12 sm:col-span-8 text-smoke">About ʻĀina Foundry</p>
        <p class="caps col-span-12 sm:col-span-4">
          The applied innovation and prototyping department of Purple Maiʻa Foundation.
        </p>
      </div>
    </div>
  </section>

  <!-- Statement -->
  <section class="on-paper bg-paper text-ink">
    <div class="wrap pt-8 pb-24 sm:pb-32">
      <div class="grid-site">
        <p class="caps col-span-6 sm:col-span-8">What we do</p>
        <p class="caps col-span-6 sm:col-span-4 text-graphite">From inspiration to infrastructure</p>
      </div>
      <p class="statement mt-40 sm:mt-56" data-reveal>
        ʻĀina Foundry exists to ensure Indigenous Innovation does not stop at inspiration — but moves
        into practice, learning, and real-world impact.
      </p>
      <p class="statement mt-6 text-graphite" data-reveal>
        Today that work centers on sovereignty: building the hardware, data systems, and AI tools that
        let Native Hawaiian knowledge be safely stored, accessed, and interpreted on our own terms.
      </p>
    </div>
  </section>

  <!-- Two concepts -->
  <section class="on-paper bg-paper text-ink border-t border-rule-light">
    <div class="wrap pt-8 pb-24 sm:pb-32">
      <div class="grid-site">
        <h2 class="caps col-span-6 sm:col-span-8">Two concepts</h2>
        <p class="caps col-span-6 sm:col-span-4 text-graphite">Building with ʻāina first</p>
      </div>

      <div class="grid-site gap-y-16 mt-20 sm:mt-28">
        <div class="col-span-12 lg:col-span-6 space-y-16">
          {[dataLayer, computeLayer].map(concept => (
            <div data-reveal>
              <h3 class="headline mb-6">{concept.name}</h3>
              <p class="caps text-graphite mb-4">{concept.question}</p>
              <p class="text-[17px] leading-relaxed max-w-[52ch]">{concept.summary}</p>
            </div>
          ))}
        </div>
        <figure class="col-span-12 lg:col-start-8 lg:col-span-5 self-end" data-reveal>
          <Picture
            src={hackathonPhoto}
            formats={['avif', 'webp']}
            widths={[400, 725]}
            sizes="(min-width: 1024px) 42vw, 100vw"
            alt="A large group of hackathon participants gathered on a stone wall in a forested valley at Puʻuhonua O Waimānalo."
            class="w-full aspect-[5/4] object-cover"
          />
          <figcaption class="caps text-graphite mt-3">2025 Build4ʻĀina Hackathon, Puʻuhonua O Waimānalo</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Values + process -->
  <section class="bg-ink text-paper">
    <div class="wrap pt-8 pb-24 sm:pb-32">
      <div class="grid-site gap-y-6">
        <h2 class="caps col-span-12 lg:col-span-6 pt-5 border-t border-rule-dark">Our values</h2>
        <ol class="col-span-12 lg:col-span-6">
          {values.map((v, i) => (
            <li class="grid grid-cols-6 gap-x-4 sm:gap-x-8 py-5 border-t border-rule-dark" data-reveal>
              <span class="caps text-smoke col-span-1 pt-1.5">0{i + 1}</span>
              <div class="col-span-5">
                <h3 class="text-xl sm:text-2xl font-medium tracking-[-0.01em] mb-2">{v.title}</h3>
                <p class="text-smoke leading-relaxed max-w-[52ch]">{v.description}</p>
              </div>
            </li>
          ))}
        </ol>

        <h2 class="caps col-span-12 lg:col-span-6 pt-5 mt-20 border-t border-rule-dark">How a project moves</h2>
        <ol class="col-span-12 lg:col-span-6 lg:mt-20">
          {process.map((step, i) => (
            <li class="grid grid-cols-6 gap-x-4 sm:gap-x-8 py-5 border-t border-rule-dark" data-reveal>
              <span class="caps text-smoke col-span-1 pt-1.5">0{i + 1}</span>
              <div class="col-span-5">
                <h3 class="text-xl sm:text-2xl font-medium tracking-[-0.01em] mb-2">{step.title}</h3>
                <p class="text-smoke leading-relaxed max-w-[52ch]">{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Parent org + contact -->
  <section class="on-paper bg-paper text-ink">
    <div class="wrap pt-8 pb-24 sm:pb-32">
      <div class="grid-site">
        <h2 class="caps col-span-6 sm:col-span-8">Parent organization</h2>
        <a href="https://purplemaia.org" target="_blank" rel="noopener noreferrer" class="caps link-line col-span-6 sm:col-span-4 justify-self-start">
          Purple Maiʻa Foundation ↗
        </a>
      </div>
      <p class="statement mt-40 sm:mt-56" data-reveal>
        ʻĀina Foundry is a department of Purple Maiʻa Foundation — a Hawaiʻi-based nonprofit connecting
        Native Hawaiian and Pacific Islander communities to STEM education and economic opportunity
        through culturally relevant programming.
      </p>
      <div class="grid-site gap-y-4 mt-24 pt-5 border-t border-rule-light">
        <p class="caps col-span-12 sm:col-span-8">Work with us</p>
        <a href={`mailto:${contactEmail}`} class="caps link-line col-span-12 sm:col-span-4 justify-self-start">{contactEmail} →</a>
      </div>
    </div>
  </section>
</BaseLayout>
