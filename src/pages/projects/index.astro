---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sorted = allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.order - b.data.order || b.data.year - a.data.year;
});

// Human-readable labels for every possible value in the schema.
const categoryLabels: Record<string, string> = {
  'place-based':                'Place-Based Engineering',
  'agentic-governance':         'Agentic Governance',
  'sustainable-ai':             'Sustainable AI Infrastructure',
  'environmental-intelligence': 'Environmental Intelligence',
  restoration:                  'ʻĀina Restoration',
  sensors:                      'Sensors & Monitoring',
  communications:               'Communications',
  data:                         'Data & AI',
  education:                    'Education',
  health:                       'Health',
  infrastructure:               'Infrastructure',
  other:                        'Other',
};

const statusLabels: Record<string, string> = {
  'initial-build': 'Initial Build',
  testing:         'Testing / QA',
  active:          'Active',
  prototype:       'Prototype',
  venture:         'Venture',
  research:        'Research',
  completed:       'Completed',
};

// Only surface filters for values that actually exist in the portfolio,
// so the controls never offer options that yield zero results.
const presentCategories = [...new Set(allProjects.map(p => p.data.category))]
  .sort((a, b) => (categoryLabels[a] ?? a).localeCompare(categoryLabels[b] ?? b));
const presentStatuses = [...new Set(allProjects.map(p => p.data.status))]
  .sort((a, b) => (statusLabels[a] ?? a).localeCompare(statusLabels[b] ?? b));

const categories = [
  { value: 'all', label: 'All Projects' },
  ...presentCategories.map(c => ({ value: c, label: categoryLabels[c] ?? c })),
];

const statuses = [
  { value: 'all', label: 'All Statuses' },
  ...presentStatuses.map(s => ({ value: s, label: statusLabels[s] ?? s })),
];
---

<BaseLayout
  title="Projects"
  description="Explore the full portfolio of ʻĀina Foundry projects — place-based engineering, agentic governance, sustainable AI infrastructure, and environmental intelligence."
>
  <!-- Page Header -->
  <section class="relative border-b border-af-border py-20 overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-40"></div>
    <div class="absolute top-1/2 left-0 w-[400px] h-[400px] bg-af-green/4 rounded-full blur-3xl pointer-events-none -translate-y-1/2"></div>

    <div class="container-site relative z-10">
      <p class="section-label mb-4">Portfolio</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-af-white mb-4">
        Projects
      </h1>
      <p class="text-af-silver max-w-2xl text-lg leading-relaxed">
        From early-stage research to active ventures — every project here was community-vetted,
        culturally grounded, and built to move ideas into real-world impact.
      </p>

      <!-- Count -->
      <div class="mt-6 flex items-center gap-2">
        <span class="font-mono text-sm text-af-green" id="project-count">{sorted.length}</span>
        <span class="text-af-gray text-sm">projects</span>
      </div>
    </div>
  </section>

  <!-- Filters -->
  <section class="sticky top-16 z-40 border-b border-af-border bg-af-black/90 backdrop-blur-md">
    <div class="container-site py-4">
      <div class="flex flex-col sm:flex-row gap-3">
        <!-- Category filter -->
        <div class="flex items-center gap-2 flex-1 overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
          {categories.map(cat => (
            <button
              data-filter="category"
              data-value={cat.value}
              class:list={[
                'filter-btn flex-shrink-0 px-3 py-1.5 text-xs font-mono rounded-sm border transition-all duration-150',
                cat.value === 'all'
                  ? 'active border-af-green text-af-green bg-af-green/10'
                  : 'border-af-border text-af-gray hover:border-af-muted hover:text-af-silver',
              ]}
            >
              {cat.label}
            </button>
          ))}
        </div>

        <!-- Status filter -->
        <select
          id="status-filter"
          class="flex-shrink-0 bg-af-surface border border-af-border text-af-silver text-xs font-mono rounded-sm px-3 py-1.5 focus:outline-none focus:border-af-green/40"
        >
          {statuses.map(s => <option value={s.value}>{s.label}</option>)}
        </select>
      </div>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="container-site py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
      {sorted.map(project => (
        <div
          data-category={project.data.category}
          data-status={project.data.status}
          class="project-item"
        >
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden py-24 text-center">
      <p class="text-af-gray text-lg font-mono">No projects match your filters.</p>
      <button id="reset-filters" class="mt-4 btn-outline text-sm">
        Reset filters
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  let activeCategory = 'all';
  let activeStatus = 'all';

  const items = document.querySelectorAll<HTMLElement>('.project-item');
  const countEl = document.getElementById('project-count');
  const emptyState = document.getElementById('empty-state');
  const grid = document.getElementById('projects-grid');

  function applyFilters() {
    let visible = 0;
    items.forEach(item => {
      const cat = item.dataset.category ?? '';
      const status = item.dataset.status ?? '';
      const show =
        (activeCategory === 'all' || cat === activeCategory) &&
        (activeStatus === 'all' || status === activeStatus);
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (countEl) countEl.textContent = String(visible);
    if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    if (grid) grid.classList.toggle('hidden', visible === 0);
  }

  // Category buttons
  document.querySelectorAll<HTMLButtonElement>('[data-filter="category"]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-filter="category"]').forEach(b =>
        b.classList.remove('active', 'border-af-green', 'text-af-green', 'bg-af-green/10')
      );
      btn.classList.add('active', 'border-af-green', 'text-af-green', 'bg-af-green/10');
      activeCategory = btn.dataset.value ?? 'all';
      applyFilters();
    });
  });

  // Status select
  document.getElementById('status-filter')?.addEventListener('change', (e) => {
    activeStatus = (e.target as HTMLSelectElement).value;
    applyFilters();
  });

  // Reset
  document.getElementById('reset-filters')?.addEventListener('click', () => {
    activeCategory = 'all';
    activeStatus = 'all';
    (document.getElementById('status-filter') as HTMLSelectElement).value = 'all';
    document.querySelectorAll('[data-filter="category"]').forEach((b, i) => {
      b.classList.toggle('active', i === 0);
      b.classList.toggle('border-af-green', i === 0);
      b.classList.toggle('text-af-green', i === 0);
      b.classList.toggle('bg-af-green/10', i === 0);
      b.classList.toggle('border-af-border', i !== 0);
      b.classList.toggle('text-af-gray', i !== 0);
    });
    applyFilters();
  });
</script>
