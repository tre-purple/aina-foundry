---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { getCollection } from 'astro:content';
import { stackLayers } from '../../data/sovereignty';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);

const filters = [
  { value: 'all', label: 'All', count: projects.length },
  ...stackLayers.map(l => ({
    value: l.key,
    label: l.name,
    count: projects.filter(p => p.data.stack === l.key).length,
  })),
];
---

<BaseLayout
  title="Projects"
  description="ʻĀina Foundry projects across the Sovereign Stack — data sovereignty, compute sovereignty, and community intelligence."
>
  <section class="bg-ink text-paper">
    <div class="wrap pt-48 sm:pt-64 pb-8">
      <h1 class="display">Projects</h1>
      <div class="grid-site gap-y-4 mt-24 sm:mt-32">
        <p class="caps col-span-12 sm:col-span-8 text-smoke">
          <span id="project-count">{projects.length}</span> projects across the Sovereign Stack
        </p>
        <p class="caps col-span-12 sm:col-span-4">
          From early builds to ventures — each one answers a question of sovereignty.
        </p>
      </div>
    </div>
  </section>

  <section class="on-paper bg-paper text-ink">
    <div class="wrap pt-8 pb-24 sm:pb-32">
      <div class="grid-site gap-y-4 mb-16 sm:mb-24">
        <p class="caps col-span-12 sm:col-span-3">Filter by layer</p>
        <div class="col-span-12 sm:col-span-9 flex flex-wrap gap-x-8 gap-y-2" role="group" aria-label="Filter projects by stack layer">
          {filters.map(f => (
            <button
              type="button"
              data-layer={f.value}
              aria-pressed={f.value === 'all' ? 'true' : 'false'}
              class="layer-btn caps text-graphite aria-pressed:text-ink link-line aria-pressed:[background-size:100%_1px] hover:text-ink transition-colors"
            >
              {f.label} <span class="text-graphite">({f.count})</span>
            </button>
          ))}
        </div>
      </div>

      <div id="project-list" class="border-b border-rule-light">
        {projects.map((project, i) => (
          <div class="project-item" data-layer={project.data.stack ?? 'none'}>
            <ProjectRow project={project} index={i} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.layer-btn');
  const items = document.querySelectorAll<HTMLElement>('.project-item');
  const countEl = document.getElementById('project-count');

  function apply(layer: string) {
    let visible = 0;
    items.forEach(item => {
      const show = layer === 'all' || item.dataset.layer === layer;
      item.hidden = !show;
      if (show) visible++;
    });
    buttons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.layer === layer)));
    if (countEl) countEl.textContent = String(visible);

    // Keep the filter in the URL so a filtered view can be shared.
    const url = new URL(window.location.href);
    if (layer === 'all') url.searchParams.delete('layer');
    else url.searchParams.set('layer', layer);
    history.replaceState(null, '', url);
  }

  buttons.forEach(b => b.addEventListener('click', () => apply(b.dataset.layer ?? 'all')));

  const initial = new URLSearchParams(window.location.search).get('layer');
  if (initial && [...buttons].some(b => b.dataset.layer === initial)) apply(initial);
</script>
