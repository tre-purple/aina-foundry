---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import hackathonPhoto from '../assets/build4aina-2025.jpg';
import { stackLayers, values } from '../data/sovereignty';
import { contactEmail, statusLabels, withBase } from '../data/site';

const allProjects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);

const layers = stackLayers.map(layer => ({
  ...layer,
  projects: allProjects.filter(p => p.data.stack === layer.key),
}));

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ʻĀina Foundry',
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  logo: new URL(withBase('apple-touch-icon.png'), Astro.site).href,
  email: contactEmail,
  description: 'Building decentralized, community-governed data and compute infrastructure that puts knowledge and decision-making back in community hands.',
  parentOrganization: {
    '@type': 'NonprofitOrganization',
    name: 'Purple Maiʻa Foundation',
    url: 'https://purplemaia.org',
  },
};

// Key words stay full-strength even when the rest of the question is dimmed.
const emphasize = (text: string, words: string[]) =>
  words.reduce((html, word) => html.replace(word, `<span class="text-ink">${word}</span>`), text);
---

<BaseLayout title="The Sovereign Stack">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organization)} />

  <!-- Hero -->
  <section class="relative min-h-[100svh] bg-ink text-paper flex flex-col overflow-hidden">
    <Picture
      src={hackathonPhoto}
      formats={['avif', 'webp']}
      widths={[480, 725]}
      sizes="100vw"
      alt=""
      loading="eager"
      pictureAttributes={{ class: 'absolute inset-0' }}
      class="w-full h-full object-cover grayscale opacity-[0.28] scale-105"
    />
    <div class="absolute inset-0 bg-linear-to-b from-ink/60 via-transparent to-ink"></div>

    <div class="wrap relative flex-1 flex flex-col pt-40 pb-8">
      <div class="grid-site gap-y-8 my-auto items-end">
        <h1 class="display col-span-12 lg:col-span-8">
          The Sovereign<br />Stack
        </h1>
        <p class="caps col-span-12 sm:col-span-6 lg:col-start-9 lg:col-span-3 lg:pb-3">
          Decentralized, community-governed data and compute infrastructure — built in Hawaiʻi, governed by Hawaiʻi.
        </p>
      </div>

      <div class="grid-site mt-16">
        <p class="caps text-smoke col-span-6 lg:col-span-8">ʻĀina Foundry · Purple Maiʻa</p>
        <a href="#story" class="caps link-line col-span-6 lg:col-span-4 justify-self-end lg:justify-self-start">Why sovereignty ↓</a>
      </div>
    </div>
  </section>

  <!-- Statement -->
  <section id="story" class="on-paper bg-paper text-ink scroll-mt-0">
    <div class="wrap pt-8 pb-24 sm:pb-32">
      <div class="grid-site">
        <p class="caps col-span-6 sm:col-span-8">The Sovereign Stack</p>
        <p class="caps col-span-6 sm:col-span-4 text-graphite">Building with ʻāina first</p>
      </div>

      <p class="statement mt-40 sm:mt-56 max-w-[34ch] sm:max-w-none" data-reveal>
        We are building decentralized, community-governed data and compute infrastructure that puts
        knowledge and decision-making back in community hands — giving us the capacity to power our
        own intelligence.
      </p>
      <p class="statement mt-6 text-graphite" data-reveal>
        We are developing protocols to explore how Native Hawaiian knowledge and data can be safely
        stored, accessed, and interpreted.
      </p>

      <figure class="grid-site gap-y-4 mt-24 sm:mt-36" data-reveal>
        <figcaption class="caps text-graphite col-span-12 lg:col-span-6 order-2 lg:order-1 self-end">
          2025 Build4ʻĀina Hackathon<br />Puʻuhonua O Waimānalo
        </figcaption>
        <Picture
          src={hackathonPhoto}
          formats={['avif', 'webp']}
          widths={[400, 725]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          alt="A large group of hackathon participants gathered on a stone wall in a forested valley at Puʻuhonua O Waimānalo."
          pictureAttributes={{ class: 'col-span-12 lg:col-span-6 order-1 lg:order-2' }}
          class="w-full aspect-[5/4] object-cover"
        />
      </figure>
    </div>
  </section>

  <!-- Why + What: the three questions, each opening onto its layer of the stack -->
  <section class="on-paper bg-paper text-ink border-t border-rule-light">
    <div class="wrap pt-8 pb-24 sm:pb-32">
      <div class="grid-site gap-y-4">
        <h2 class="caps col-span-12 sm:col-span-8">Achieving sovereignty</h2>
        <p class="caps col-span-12 sm:col-span-4 text-graphite">
          Every system that holds community knowledge answers three questions. We build so the answer, in Hawaiʻi, is us.
        </p>
      </div>

      <div id="sovereignty" class="mt-20 sm:mt-28 lg:grid lg:grid-cols-12 lg:gap-x-8">
        {layers.map((layer, i) => (
          <div class="contents">
            <h3
              class="lg:col-span-8 lg:col-start-1 border-t border-rule-light lg:border-0"
              style={`grid-row: ${i + 1}`}
            >
              <button
                type="button"
                class:list={['sov-q group w-full text-left pt-6 pb-4 lg:py-2 headline transition-colors duration-500', i === 0 ? 'lg:text-ink' : 'lg:text-ghost']}
                data-index={i}
                aria-controls={`layer-${layer.key}`}
              >
                <span set:html={emphasize(layer.question, layer.highlights)} />
              </button>
            </h3>
            <div
              id={`layer-${layer.key}`}
              class:list={['sov-panel lg:col-start-9 lg:col-span-4 lg:row-start-1 lg:row-span-3 pb-10 lg:pb-0 lg:pt-3 transition-opacity duration-500', i === 0 ? 'is-active' : '']}
            >
              <p class="caps text-graphite mb-1">Layer 0{i + 1}</p>
              <p class="caps mb-5">{layer.name}</p>
              <p class="text-[17px] leading-relaxed mb-8 max-w-[44ch]">{layer.summary}</p>
              <ul>
                {layer.projects.map(project => (
                  <li class="border-t border-rule-light">
                    <a href={withBase(`projects/${project.id}/`)} class="group flex justify-between gap-4 py-2.5">
                      <span class="caps link-line">{project.data.title}</span>
                      <span class="caps text-graphite shrink-0">{statusLabels[project.data.status]}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How: values -->
  <section class="bg-ink text-paper">
    <div class="wrap pt-28 sm:pt-40 pb-24 sm:pb-32">
      <p class="statement" data-reveal>
        We build on hardware we own, guided by Native Hawaiian values and the CARE Principles —
        powered by renewable energy, and designed so communities can repair, upgrade, and maintain
        it themselves.
      </p>

      <div class="grid-site gap-y-6 mt-28 sm:mt-40">
        <h2 class="caps col-span-12 lg:col-span-6 pt-5 border-t border-rule-dark">Our values</h2>
        <ol class="col-span-12 lg:col-span-6">
          {values.map((v, i) => (
            <li class="grid grid-cols-6 gap-x-4 sm:gap-x-8 py-5 border-t border-rule-dark" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              <span class="caps text-smoke col-span-1 pt-1.5">0{i + 1}</span>
              <div class="col-span-5">
                <h3 class="text-xl sm:text-2xl font-medium tracking-[-0.01em] mb-2">{v.title}</h3>
                <p class="text-smoke leading-relaxed max-w-[52ch]">{v.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="on-paper bg-paper text-ink">
    <div class="wrap pt-8 pb-24 sm:pb-32">
      <div class="grid-site mb-20 sm:mb-28">
        <h2 class="caps col-span-6 sm:col-span-8">Current work</h2>
        <a href={withBase("projects/")} class="caps link-line col-span-6 sm:col-span-4 justify-self-start">All projects →</a>
      </div>
      <div class="border-b border-rule-light">
        {allProjects.map((project, i) => <ProjectRow project={project} index={i} />)}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="bg-ink text-paper">
    <div class="wrap pt-8 pb-24 sm:pb-32">
      <div class="grid-site gap-y-4">
        <h2 class="caps col-span-12 sm:col-span-8">Get involved</h2>
        <p class="caps col-span-12 sm:col-span-4 text-smoke">
          We work with community organizations, builders, and partners who want their data, their
          machines, and their values to stay in Hawaiʻi.
        </p>
      </div>
      <p class="display mt-28 sm:mt-40" data-reveal>Build with<br />ʻāina first.</p>
      <a href={`mailto:${contactEmail}`} class="statement link-line inline-block mt-10">{contactEmail} →</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Desktop: hovering or focusing a question brings its layer forward and dims the others.
  const questions = document.querySelectorAll<HTMLButtonElement>('.sov-q');
  const panels = document.querySelectorAll<HTMLElement>('.sov-panel');

  function activate(index: number) {
    questions.forEach((q, i) => {
      q.classList.toggle('lg:text-ink', i === index);
      q.classList.toggle('lg:text-ghost', i !== index);
    });
    panels.forEach((p, i) => p.classList.toggle('is-active', i === index));
  }

  questions.forEach((q, i) => {
    q.addEventListener('mouseenter', () => activate(i));
    q.addEventListener('focus', () => activate(i));
    q.addEventListener('click', () => activate(i));
  });
</script>

<style>
  @media (min-width: 1024px) {
    .sov-panel:not(.is-active) {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
